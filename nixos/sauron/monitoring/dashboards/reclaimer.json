{
  "annotations": { "list": [] },
  "description": "Project Reclaimer (Halo 3) dedicated servers, from each server's metrics_http /metrics.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "title": "Servers",
      "type": "stat",
      "targets": [{ "expr": "up{job=\"reclaimer\"}", "legendFormat": "{{server}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "title": "Players now",
      "type": "stat",
      "targets": [{ "expr": "reclaimer_players", "legendFormat": "{{server}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name"
      },
      "title": "Uptime",
      "type": "stat",
      "targets": [{ "expr": "reclaimer_up_seconds", "legendFormat": "{{server}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "lineInterpolation": "stepAfter" },
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Players",
      "type": "timeseries",
      "targets": [{ "expr": "reclaimer_players", "legendFormat": "{{server}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Engine frames a second over the last minute with players on (0 while nobody plays). Below 90% of the tick rate (54 of 60, 27 of 30) the server is falling behind.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 },
          "unit": "hertz",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Frame rate (with players on)",
      "type": "timeseries",
      "targets": [{ "expr": "reclaimer_frame_rate_hz > 0", "legendFormat": "{{server}} (tick {{tick_rate}})" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 },
          "unit": "ms",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 6,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Frame time p50 / p99",
      "type": "timeseries",
      "targets": [
        { "expr": "reclaimer_frame_ms_p50 > 0", "legendFormat": "{{server}} p50" },
        { "expr": "reclaimer_frame_ms_p99 > 0", "legendFormat": "{{server}} p99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "unit": "Bps",
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 7,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "Network",
      "type": "timeseries",
      "targets": [
        { "expr": "reclaimer_upload_bytes_per_second", "legendFormat": "{{server}} up" },
        { "expr": "reclaimer_download_bytes_per_second", "legendFormat": "{{server}} down" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["games", "reclaimer"],
  "time": { "from": "now-24h", "to": "now" },
  "title": "Halo 3 (Project Reclaimer)",
  "uid": "reclaimer"
}
